m4_foreach([x], [icon_supported_bundled_python],
  [AC_SUBST(AS_TR_CPP([x])[_PYTHON_ENABLED], ['#'])])dnl
for icon_bundled_name in m4_join([ ], icon_supported_bundled_python); do
  AS_VAR_IF([icon_${icon_bundled_name}_python], [yes],
