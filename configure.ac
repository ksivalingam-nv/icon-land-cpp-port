   AC_SUBST([FC_MOD_FILE_PROXYEXT], ['.proxy'])
   AC_SUBST([FC_MOD_FILE_SPROXYEXT], ['.sproxy'])],
  [AC_SUBST([DEVELOPER_MODE_ENABLED], ['#'])
