  AS_IF([test -n "$ICON_FCGROUP_FLAGS"],
    [AS_VAR_APPEND([ICON_FCGROUP_FLAGS], ["
"])])
  AS_VAR_APPEND([ICON_FCGROUP_FLAGS],
