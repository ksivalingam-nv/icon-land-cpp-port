#
# Insert test suite settings
#

VERSION_ = $$Id: run/mkexp/options/test/suite.config 2 2026-02-27 12:51:37Z k202123 $$

[jobs]
  .remove += test_start
  .type = serial

  [[remove_files]]
    args = $SCRIPT_DIR/$EXP_ID.date

  [[diff_test]]
    .var_format = {%s}

  [[run_tests]]

  [[run_start]]
    .trigger = run_tests

  [[test_start]]
    .extends = run_start

  [[run_restart_start]]
    .extends = test_start
    .trigger = run_restart
    subdir = run_restart_start
    interval = $TEST_RESTART_INTERVAL
    [[[namelists]]]
      [[[[icon_master.namelist]]]]
        [[[[[master_time_control_nml]]]]]
          checkpointtimeintval = $TEST_RESTART_INTERVAL
          restarttimeintval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_atm]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_oce]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_lnd]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL
  [[run_restart]]
    .extends = run
    .trigger = remove_files, diff_test -O $subdir -O run_restart_start
    subdir = run_restart
    interval = $TEST_RESTART_INTERVAL
    [[[namelists]]]
      [[[[icon_master.namelist]]]]
        [[[[[master_time_control_nml]]]]]
          checkpointtimeintval = $TEST_RESTART_INTERVAL
          restarttimeintval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_atm]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_oce]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL
      [[[[NAMELIST_lnd]]]]
        [[[[[output_nml]]]]]
          file_interval = $TEST_RESTART_INTERVAL

  [[run_openmp_start]]
    .hide = eval(not is_set('$openmp_enabled'))
    .extends = test_start
    .trigger = diff_test -O $subdir
    subdir = run_openmp
    [[[env]]]
      OMP_NUM_THREADS = 1

  [[run_nproma_start]]
    .extends = test_start
    .trigger = diff_test -O $subdir
    subdir = run_nproma
    [[[namelists]]]
      [[[[NAMELIST_atm]]]]
        [[[[[parallel_nml]]]]]
          nproma    = eval($DEFAULT_ATMO_NPROMA    + 1 if not is_set('$gpu_enabled') else '')
          nblocks_c = eval($DEFAULT_ATMO_NBLOCKS_C + 1 if     is_set('$gpu_enabled') else '')
      [[[[NAMELIST_oce]]]]
        [[[[[parallel_nml]]]]]
          nproma    = eval($DEFAULT_OCEAN_NPROMA    + 1 if not is_set('$gpu_enabled') else '')
          nblocks_c = eval($DEFAULT_OCEAN_NBLOCKS_C + 1 if     is_set('$gpu_enabled') else '')
      [[[[NAMELIST_lnd]]]]
        [[[[[parallel_nml]]]]]
          nproma    = eval($DEFAULT_ATMO_NPROMA    + 1 if not is_set('$gpu_enabled') else '')
          nblocks_c = eval($DEFAULT_ATMO_NBLOCKS_C + 1 if     is_set('$gpu_enabled') else '')

  [[run_mpi_start]]
    .hide = eval(not is_set('$mpi_enabled'))
    .extends = test_start
    .trigger = diff_test -O $subdir
    subdir = run_mpi
    [[[processes]]]
      [[[[dummy]]]]
        tasks_per_node = 0
        tasks = -1

  [[run_cudagraph_start]]
    .hide = eval(not is_set('$cuda_enabled'))
    .extends = test_start
    .trigger = diff_test -O $subdir
    subdir = run_cudagraph
    [[[namelists]]]
      [[[[NAMELIST_atm]]]]
        [[[[[nwp_phy_nml]]]]]
          lcuda_graph_turbtrans = eval(not '$DEFAULT_USE_CUDA_GRAPHS')
        [[[[[lnd_nml]]]]]
          lcuda_graph_lnd = eval(not '$DEFAULT_USE_CUDA_GRAPHS')
        [[[[[aes_vdf_nml]]]]]
          aes_vdf_config(1)%lcuda_graph_vdf = eval(not '$DEFAULT_USE_CUDA_GRAPHS')
