#
# Setup for levante (SLURM)
# $Id: levante.tmpl 2 2025-02-11 k202123 $
#
#SBATCH --job-name=%{EXP_ID}.run
#%  if JOB.job_type == 'parallel':
#SBATCH --account=%{JOB.account|d(ACCOUNT)}
#SBATCH --output=%{LOG_DIR}/%{EXP_ID}.run.%8j.log
#%    if JOB.qos is defined:
#SBATCH --qos=%{JOB.qos}
#%    endif
#SBATCH --partition=%{JOB.partition|d('compute')|join(',')}
#SBATCH --nodes=%{JOB.nodes}
#%    if JOB.use_gpus is set:
#SBATCH --gpus-per-node=%{JOB.gpus_per_node|d(JOB.default_gpus_per_node)}
#%    else
#%      set cpus_per_task = JOB.threads_per_task
#%    endif
#SBATCH --mem=0
#%  if JOB.exclusive is set:
#SBATCH --exclusive
#%  endif
#SBATCH --time=%{JOB.time_limit}
#%  endif
#%#------ job_type parallel
#%  if EMAIL is defined:
#SBATCH --mail-type=FAIL,ARRAY_TASKS
#SBATCH --mail-user=%{JOB.email|d(EMAIL)|join(',')}
#%  endif
#%  for var in JOB.batch|d({}):
#%    set val = JOB.batch[var]|list|join(',')
#%    if val|lower == 'true':
#SBATCH --%{var}
#%    elif ' ' in val:
#SBATCH --%{var}='%{val}'
#%    elif val:
#SBATCH --%{var}=%{val}
#%    endif
#%  endfor
#%# Environment variables and resource limits
#%  include 'mkexp/environments/resources/DEFAULT.tmpl'
