VERSION_ = $$Id: run/mkexp/environments/DEFAULT.config 7 2026-02-27 12:50:34Z k202123 $$

# Blocking parameter for grid decomposition
#  nproma for ATM and OCE,         ICON default: 1 if nblocks_c and nblocks_e are not set
DEFAULT_ATMO_NPROMA =
DEFAULT_OCEAN_NPROMA =
#  nproma_sub for radiation,       ICON default: computed based on nblocks_sub
DEFAULT_ATMO_NPROMA_SUB =
#  nblocks_c for ATM and OCE,      ICON default: 0
DEFAULT_ATMO_NBLOCKS_C =
DEFAULT_OCEAN_NBLOCKS_C =
#  nblocks_sub used for radiation, ICON default: 1 if nproma_sub not set
DEFAULT_ATMO_NBLOCKS_SUB =

# System optimizations
DEFAULT_USE_CUDA_GRAPHS = false

[jobs]

  ldd = ldd
  batch_command = $ksh
  progress_command = echo progress indicator:
  log_file_command =

  # Environment variables for job information
  name_environ = 0
  id_environ = $$
  task_id_environ = # OMPI_COMM_WORLD_LOCAL_RANK for OpenMPI, PMI_RANK for hydra (MPICH, IntelMPI)

  hardware_threads = true
  default_threads_per_task = 1
  default_cpus_per_node = 4
  cpus_per_thread = 1

  threads_per_task = $default_threads_per_task
  cpus_per_task = eval($threads_per_task*$cpus_per_thread)
  cpus_per_node = $default_cpus_per_node

  [[run]]
    use_hostfile = false
    [[[limits]]]
      core = 0
      stack = unlimited

[MPI]

  command = eval("$MPI_LAUNCH" if "$MPI_LAUNCH" else "mpiexec")
