requested_count=%{requested|length}
rank=$(( (%{JOB.task_id_environ} - %{info.task_offset|d(0)})/%{info.task_block_size|d(1)} ))
rank_default=$(( rank < requested_count ? rank : requested_count ))
rank_cyclic=$(( rank % requested_count ))
numanode=( %{numa_list|join(' ')} )
sockets=( %{requested|join(' ')} '' )
#%    if nic_list:
nics=( %{nic_list|join(' ')} )
#%    endif
#%    if JOB.debug_level|d(0)|int > 0:
echo "Compute process $%{JOB.task_id_environ} on $(hostname)"
#%    endif
if [[ -n "${sockets[rank_default]}" ]]
then
    export %{JOB.visible_environ}=${sockets[rank_default]}
fi
#%    if nic_list:
export UCX_NET_DEVICES=${nics[rank_cyclic]}
