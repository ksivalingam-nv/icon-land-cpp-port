#
# Mapping of build info to mkexp environment
#

[dolpung_gpu]
  host_fqdn = l504[0-3]?.lvt.dkrz.de, l5044[02].lvt.dkrz.de
[levante_gpu]
  host_fqdn = l*.lvt.dkrz.de
  gpu_enabled = true
[levante]
  host_fqdn = l*.lvt.dkrz.de
[lumi_gpu]
  host_fqdn = uan0?, nid00????
  gpu_enabled = true
[lumi]
  host_fqdn = uan0?, nid00????
[mpimet]
  host_fqdn = *.mpimet.mpg.de
  host_os = linux-gnu
[macOS]
  host_os = darwin*
