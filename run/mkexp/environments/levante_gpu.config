VERSION_ = $$Id: run/mkexp/environments/levante_gpu.config 5 2026-04-01 13:45:44Z m221078 $$

ACCOUNT = """eval("$DEFAULT_ACCOUNT" if "$DEFAULT_ACCOUNT" else feedback.die("please set ACCOUNT to your levante compute project, either in your experiment config or on the command line, or save the project name to '$HOME/.acct'"))"""

INPUT_ROOT = /pool/data
WORK_ROOT = "eval('/scratch/'+'$USER'[0]+'/$USER')"
DATA_ROOT = /work/$PROJECT_SUBDIR/$USER

# Control compression of output data
WRITE_COMPRESSION = lz4
DEFAULT_HDF5_PLUGIN_PATH = /sw/spack-levante/netcdf-c-main-bdxvs5/plugins

# Blocking parameter for grid decomposition
#  nproma for ATMO and OCEAN,      ICON default: 1 if nblocks_c and nblocks_e are not set
DEFAULT_ATMO_NPROMA =
DEFAULT_OCEAN_NPROMA =
#  nproma_sub for radiation,       ICON default: computed based on nblocks_sub
DEFAULT_ATMO_NPROMA_SUB =
#  nblocks_c for ATMO and OCEAN,   ICON default: 0
DEFAULT_ATMO_NBLOCKS_C = 1
DEFAULT_OCEAN_NBLOCKS_C = 1
#  nblocks_sub used for radiation, ICON default: 1 if nproma_sub not set
DEFAULT_ATMO_NBLOCKS_SUB = 6

# System optimizations
DEFAULT_USE_CUDA_GRAPHS = true

[jobs]

  cdo = CDO_ICON_GRIDS=/pool/data/ICON HDF5_PLUGIN_PATH=$DEFAULT_HDF5_PLUGIN_PATH /sw/spack-levante/cdo-2.2.2-4z4icb/bin/cdo

  batch_command = sbatch
  progress_command = sh -c 'scontrol update JobId=$$SLURM_JOB_ID Comment="$$*"' scomment
  hostnames_command = scontrol show hostnames "$$SLURM_NODELIST"
  log_file_command = sacct -XPnj $$$id_environ -o stdout --expand-patterns
  ksh = /bin/bash

  # Environment variables for job information
  name_environ = SLURM_JOB_NAME
  id_environ = SLURM_JOBID
  task_id_environ = SLURM_LOCALID

  # Environment variables for accelerator selection
  visible_environ = CUDA_VISIBLE_DEVICES

  # Hardware parameters
  default_gpus_per_node = 4    # = 4 sockets/node x 1 GPUs/socket
  default_cpus_per_node = 128  # = 4 sockets/node x 32 CPU cores/socket
  default_threads_per_task = eval(4 if is_set('$openmp_enabled') else 1)
  hardware_threads =

  [[run]]
    .control = update "$$LOG_FILE" $$$$
    use_gpus = true
    use_cpu_mask = false
    use_hostfile = true
    use_mpmd = true
    use_wrappers = true
    partition = gpu
    nodes = 1
    threads_per_task = 1   # =OMP_NUM_THREADS
    [[[batch]]]
      constraint = a100_80 # use nodes with 80GB memory only
    [[[env]]]
      # OpenMP
      OMP_DYNAMIC = false
      OMP_SCHEDULE = dynamic,1
      OMP_STACKSIZE = 200M
      # OpenMPI
      OMPI_MCA_osc = ucx
      OMPI_MCA_pml = ucx
      # Unified Communication X
      UCX_RNDV_THRESH = 16384
      # HDF5 Library
      HDF5_USE_FILE_LOCKING = FALSE
      HDF5_PLUGIN_PATH = $DEFAULT_HDF5_PLUGIN_PATH
      # GNU C Library
      MALLOC_TRIM_THRESHOLD_ = -1
      # NVIDIA
      NVCOMPILER_ACC_USE_GRAPH = 1
    [[[processes]]]
      gpus_per_node = $default_gpus_per_node
      [[[[atmo]]]]
        use_accelerators = true
        tasks_per_node = $gpus_per_node
        [[[[[env]]]]]
          UCX_TLS = self, sm, rc_x, ud_x, cuda_ipc, cuda_copy
      [[[[land]]]]
        use_accelerators = true
        tasks_per_node = $gpus_per_node
        [[[[[env]]]]]
          UCX_TLS = self, sm, rc_x, ud_x, cuda_ipc, cuda_copy

  [[mon]]
    partition = shared

  [[clean]]
    partition = compute
    tasks = 128
    time_limit = 30

  [[intake]]
    python3 = /usr/bin/env python3

  [[update]]

[MPI]
  command = srun -l --kill-on-bad-exit=1 --export=ALL

[accelerators]
  [[0]]
    numa = 2-3
    nic = mlx5_0:1
  [[1]]
    numa = 0-1
    nic = mlx5_0:1
  [[2]]
    numa = 6-7
    nic = mlx5_1:1
  [[3]]
    numa = 4-5
    nic = mlx5_1:1
