#% macro define_MODEL_executable(JOB, BIN_DIR, model_exe):
#% if JOB.hybrid is defined
export MODEL_oce="%{JOB.hybrid.oce.exec}"
export MODEL_atm="%{JOB.hybrid.atm.exec}"
#% else
export MODEL="%{BIN_DIR}/%{model_exe}"
#% endif
#%- endmacro


#%  macro check_MODEL_executable(JOB):
#%  if JOB.hybrid is defined
test -x ${MODEL_oce} || echo "${MODEL_oce} does not exist?"
test -x ${MODEL_atm} || echo "${MODEL_atm} does not exist?"
#%    if JOB.debug_level|d(0)|int >= 2:
%{JOB.ldd} ${MODEL_oce}
%{JOB.ldd} ${MODEL_atm}
#%    endif
#%  else
test -x ${MODEL} || echo "${MODEL} does not exist?"
#%    if JOB.debug_level|d(0)|int >= 2:
%{JOB.ldd} ${MODEL}
#%    endif
#%  endif
#%- endmacro
