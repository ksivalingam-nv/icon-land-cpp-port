#
# Check run log file for job information and update
#
# %{mkexp_input}
# $Id: run/mkexp/defaults/DEFAULT.update.tmpl 1 2025-10-27 22:05:34Z m221078 $
# %{VERSIONS_|join('\n# ')}
#

LOG_FILE="${1-}"
[ -z "$LOG_FILE" ] && exit # no log file, no update
CONTROL_PID=$2

tail --pid=$CONTROL_PID -F $LOG_FILE |
awk -v COMMAND='%{JOB.progress_command|replace("'", "'\\''")}' '
    /Time step/ {
        gsub("^.*model time ", "");
        gsub(":.*$", "");
        CURRENT=$1 "T" $2
    };
    CURRENT!=LAST {system(COMMAND " " CURRENT); LAST=CURRENT}
'
