#%    if WITH_ATMO is set:
if [ -z "${next_date_orig:-}" ] || %{atmo_restart_write|lower}
then
    cp -lrfv %{atmo_restart|replace('<rsttime>', '${next_stamp}Z')} $WORK_DIR
fi
#%    endif
#%    if WITH_OCEAN is set:
if [ -z "${next_date_orig:-}" ] || %{ocean_restart_write|lower}
then
    cp -lrfv %{ocean_restart|replace('<rsttime>', '${next_stamp}Z')} $WORK_DIR
fi
#%    endif
#%    if WITH_LAND is set and WITH_ATMO is not set:
if [ -z "${next_date_orig:-}" ] || %{land_restart_write|lower}
then
    cp -lrfv %{land_restart|replace('<rsttime>', '${next_stamp}Z')} $WORK_DIR
fi
#%    endif
