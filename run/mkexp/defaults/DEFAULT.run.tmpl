#%     if JOB.use_hostfile is set:
    # Clean SLURM_HOSTFILE
    unset SLURM_HOSTFILE
#%     endif
    next_job=$EXP_ID.%{job}
    next_job_args='%{args}'
    next_job_date=${next_job}_$next_date
    [[ -e $next_job_date ]] && next_job=$next_job_date
    echo "restart: submitting '$next_job $next_job_args'"
    %{JOB.batch_command} $next_job $next_job_args
  ) || status=$?
fi
#%   elif type == 'serial':
echo "running '%{EXP_ID}.%{trigger}'"
./%{EXP_ID}.%{trigger} $start_date || status=$?
#%   else:
echo "submitting '%{EXP_ID}.%{trigger}'"
(
  # Clean SLURM environment
  eval $(%{JOB.python3} -c 'import os
for key in os.environ:
    if key.startswith("SLURM_"): print("unset "+key)')
  %{JOB.batch_command} %{EXP_ID}.%{trigger} $start_date
) || status=$?
#%   endif
#% endfor

exit $status
