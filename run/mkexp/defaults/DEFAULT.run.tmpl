rm -f finish*.status

#%  if JOB.use_hostfile is set:
(
    hosts=( $(%{JOB.hostnames_command}) )
    exec > hostfile
#%    for (process, info) in processes|items:
#%      set start = info.node_start|d(0)
#%      set stop = info.node_stop|d('${#hosts[@]}')
#%      set step = info.node_step|d(1)

    # Host mapping for "%{process}" process

    total=0
    for(( h=%{start}; h<%{stop}; h+=%{step} ))
    do
        for(( i=0; i<%{info.tasks_per_node} && total<%{info.tasks}; ++i, ++total ))
        do
            echo ${hosts[h]}
        done
    done
#%    endfor
)
export SLURM_HOSTFILE=hostfile

#%  endif
