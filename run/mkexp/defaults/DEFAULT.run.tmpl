%{MPI.command} %{task_list|join(' : ')}
#%#
# Check the model results

for status_file in finish*.status
do
    result=$(cat $status_file 2> /dev/null || echo MISSING)
    result=${result# }

    echo "$status_file: $result"

    if [[ "$result" != "${last_result-$result}" ]]
    then
        echo "Sorry: result from $status_file is inconsistent with the last" >&2
        exit 1
    fi

    last_result=$result
done
finish_status=$last_result

if [[ $finish_status == OK ]]
then
    echo "Experiment finished successfully"
elif [[ $finish_status == RESTART ]]
then
    echo "Experiment to be continued"
else
    echo 'Sorry: model failure, check error messages' >&2
    exit 1
fi

