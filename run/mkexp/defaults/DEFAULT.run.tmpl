# Convenience link to log file
# - if log file is set, output not a tty, and CI unset or empty
#%  if JOB.log_file_command:
LOG_FILE=$(%{JOB.log_file_command})
#%  else:
LOG_FILE=
#%  endif
if [[ -n "$LOG_FILE" && ! -t 1 && -z "${CI-}" ]]
then
    ln -snvf $LOG_FILE $SCRIPT_DIR/%{EXP_ID}.run.log
fi

#%  if JOB.log_timestamps is set:
# Support log style output
pipe=${EXP_ID}_%{JOB.id}_$$.pipe
mkfifo $pipe
trap "cd $PWD && rm -f $pipe" EXIT
timewarp $pipe &
exec > $pipe 2>&1

#%  endif
