#%  for namelist in namelists.sections if namelists[namelist]['.hide'] is not set and namelist not in namelists['.remove']|d([]):
cat > '%{namelist}' << EOF
%{context(namelist|upper|replace('.', '_'))}
EOF

#%  endfor

# Provide input files

%{format_files(files, 'yr', 'y0', 'yN')}

#% if JOB.debug_level|d(0)|int > 0:
