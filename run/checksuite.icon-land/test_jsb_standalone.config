#--------------------------------------------------------------------------------------------------
#
# This config runs a standard ICON-Land standalone experiment using the JSBACH configuration.
# This config is set-up for testing purposes.
#

EXP_TYPE     = land/icon-land-standalone-R02B04

LAND_USECASE = jsbach_lite
LAND_WITH_CARBON = false
LAND_REFERENCE_YEAR = 1979
INITIAL_DATE = 1979-01-01
FINAL_DATE   = 1979-01-01T03:00:00Z
INTERVAL = PT3H
FILE_INTERVAL = $INTERVAL
OUTPUT_INTERVAL = PT30M

TEST_RESTART_INTERVAL = PT1H30M

[jobs]
  .remove += post, mon, mon_index, mon_log, intake
  [[run_start]]
    nodes = 1
    time_limit = 00:10:00
