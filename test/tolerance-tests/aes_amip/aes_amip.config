EXP_TYPE = amip-aes-R2B4
EXP_OPTIONS = suppress_default_output

INITIAL_DATE = 2020-01-01T00:00:00Z
FINAL_DATE = 2020-01-01T01:00:00Z

ATMO_TIME_STEP = PT2M
ATMO_RADIATION_TIME_STEP = $ATMO_TIME_STEP

[jobs]
  [[run]]
    .trigger = run
    nodes = 1
    time_limit = 00:10:00

[namelists]
  [[NAMELIST_atm]]
    [[[output_nml aes_amip_2d]]]
      file_interval = P1D
      filename_format = <output_filename>
      output_filename = ${EXP_ID}_2d
      filetype = 5
      mode = 1
      output_start = $INITIAL_DATE
      output_end = $FINAL_DATE
      output_interval = $ATMO_TIME_STEP
      ml_varlist = pr, tas, ps, rsut
    [[[output_nml aes_amip_3d]]]
      file_interval = P1D
      filename_format = <output_filename>
      output_filename = ${EXP_ID}_3d
      filetype = 5
      mode = 1
      output_start = $INITIAL_DATE
      output_end = $FINAL_DATE
      output_interval = $ATMO_TIME_STEP
      pl_varlist = hus, ta
      p_levels = 50000,85000
