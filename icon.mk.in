################################# DIRECTORIES ##################################

# Path to the root source directory:
srcdir:= @srcdir@

# Relative paths to the directories with the ICON source code:
subdirs:= src support

# Relative path to the directory with the source code of the test suite:
test_subdir:= test/unit-tests

# Relative paths to directories with source code that is irrelevant to ICON and
# its test suite:
ignored_subdirs:=

# Relative paths to the root build directories of all bundled packages:
bundled_builddirs:= @icon_bundled_builddirs@

# Relative paths to the root build directories of the CMake-based bundled
# packages:
bundled_cmake_builddirs:= @icon_bundled_cmake_builddirs@

# Relative paths to the root build directories of the Autoconf-based bundled
# packages:
bundled_config_builddirs:= $(filter-out $(bundled_cmake_builddirs),$(bundled_builddirs))

# Relative path to the directory with the Fortran module files:
mod_builddir:= mod

# When the two-step compilation is enabled:
#   1. Fortran module files that are generated together with the object file
#      become an unwanted side effect. More often than not, Fortran compilers do
#      not have special flags to suppress the generation of the module files.
#   2. In certain scenarios (e.g. when generating the coverage note files),
#      although omitting the generation of object files, the compilers generate
#      extra files based on the specified object file name, which are equally
#      unwanted.
# We use the following directory as a trash bin to catch them:
@SEPARATE_MODS_ENABLED@mod_builddir_null:= $(mod_builddir)/null

# Relative path to the directory with the generated executables:
bin_builddir:= bin

# Relative path to the directory with the generated archives:
lib_builddir:= lib

########################### BUILDING TOOLS AND FLAGS ###########################

# Compilers and utilities:
SHELL:= @SHELL@
AR:= @AR@
ARFLAGS:= @ARFLAGS@
RANLIB:= @RANLIB@
CC:= @CC@
FC:= @FC@
CXX:= @CXX@
CUDACXX:= @CUDACXX@
HIPCXX:= @HIPCXX@
PYTHON:= @PYTHON@
PVCS:= $(PYTHON) $(srcdir)/utils/pvcs.py
DEPLIST:= $(PYTHON) $(srcdir)/utils/mkhelper/deplist.py
DEPGEN:= $(PYTHON) $(srcdir)/utils/mkhelper/depgen.py
@DEVELOPER_MODE_ENABLED@MODCMP:= $(PYTHON) $(srcdir)/utils/mkhelper/fortmodcmp.py
DSL4JSB:= $(PYTHON) $(srcdir)/externals/jsbach/scripts/dsl4jsb/dsl4jsb.py
SB2PP:= @SB2PP@
FPP:= @FPP@
INSTALL:= @INSTALL@
MKDIR_P:= @MKDIR_P@
MPI_LAUNCH:= @MPI_LAUNCH@

# Installation settings:
TRANSFORM=@program_transform_name@

# Fortran compiler flags:
FCFLAGS:= @FCFLAGS@
make_FCFLAGS:= @FC_MOD_IN@$(mod_builddir)
ICON_FCFLAGS:= @ICON_FCFLAGS@
@ICON_FCGROUP_FLAGS@
DEPGEN_FCFLAGS:= @DEPGEN_FCFLAGS@

# C compiler and preprocessor flags:
CFLAGS:= @CFLAGS@
CPPFLAGS:= -I. @DEFS@ @CPPFLAGS@

# Secondary GPU compiler flags:
CUDAFLAGS:= @CUDAFLAGS@
HIPFLAGS:= @HIPFLAGS@

# Linker flags and libraries:
LDFLAGS:= @LDFLAGS@ @ICON_LDFLAGS@
BUNDLED_LIBFILES:= @BUNDLED_LIBFILES@
LIBS:= @LIBS@

############################ SOURCE FILE COLLECTION ############################

# Common infix for all preprocessed files:
pp_infix:= .pp-

# Auxiliary function. Receives a base directory, a space-separated list of
# subdirectories inside that base directory, a space-separated list of shell
# patterns and a space-separated ignore list of subdirectories inside the base
# directory. Returns a space-separated list of relative (with respect to the
# base directory) paths to files residing in the given subdirectories and
# matching at least one of the given patterns. Files residing in subdirectories
# from the ignore list (i.e. the fourth argument) are ignored. Files, as well as
# the second and higher order subdirectories, with names starting with a dot are
# ignored. Files containing the preprocessor infix '*$(pp_infix)*' are ignored.
# Duplicates are eliminated.
find_files= $(sort $(patsubst $(1)/%,%, \
                $(shell find $(addprefix $(1)/,$(2)) \
                    \( $(foreach p,$(4),-path '$(1)/$(p)' -o) \
                        -name '.' -o -name '..' -o -name '.*' \) \
                    -prune -o \
                    \( \! \( -type d -o -name '*$(pp_infix)*' \) -a \
                        \( $(foreach p,$(3),-name $(p) -o) -false \) \) \
                    -print )))

# Auxiliary function. Receives a space-separated list of make patterns and a
# space-separated list of paths. Returns a space-separated list of all paths
# for which the non-directory part matches any of the patterns.
filter_notdir_patterns= $(foreach v,$(2),$(if $(filter $(1),$(notdir $(v))),$(v)))

# Auxiliary function. Receives a string and a space-separated list of paths.
# Returns a space-separated list of all paths for which the non-directory part
# contains the string as a substring.
filter_notdir_substring= $(foreach v,$(2),$(if $(findstring $(1),$(notdir $(v))),$(v)))

# List of all source files:
all_files:= $(call find_files,$(srcdir),$(subdirs) $(test_subdir), \
                '*.f90' '*.inc' '*.incf' '*.c' '*.cu' '*.hip.cc',$(ignored_subdirs))

# List of all generated source files (except for version.c, which we have to
# handle separately to avoid multiple regenerations when running recursive
# recovery recipes):
gen_files:=

# Paths to the root source directories of all extra packages to be passed to the
# version provenance collection tool:
PVCS_bundled_srcdirs:= @icon_pvcs_bundled_srcdirs@

# JSBACH sources (must be preprocessed with DSL4JSB):
@JSBACH_ENABLED@JSBACH_subdir:= externals/jsbach/src
@JSBACH_ENABLED@JSBACH_dsl_files:= $(call find_files,$(srcdir),$(JSBACH_subdir),'*.f90')
@JSBACH_ENABLED@PVCS_bundled_srcdirs+= $(srcdir)/externals/jsbach

# DACE sources (fetched to the build directory):
@DACE_ENABLED@DACE_subdir:= @icon_dace_subdir@/src_for_icon
# Make sure the repository clone is up-to-date before searching for files:
@DACE_ENABLED@include @icon_dace_fetchstamp@
@DACE_ENABLED@DACE_all_files:= $(call find_files,.,$(DACE_subdir),'*.f90' '*.inc' '*.incf' '*.c')
@DACE_ENABLED@DACE_inc_files:= $(filter %.inc %.incf,$(DACE_all_files))
@DACE_ENABLED@all_files+= $(filter-out $(DACE_inc_files),$(DACE_all_files))

# EMVORADO sources:
@EMVORADO_ENABLED@EMVORADO_subdir:= externals/emvorado
@EMVORADO_ENABLED@all_files+= $(call find_files,$(srcdir),$(EMVORADO_subdir),'*.f90' '*.incf')
@EMVORADO_ENABLED@PVCS_bundled_srcdirs+= $(srcdir)/$(EMVORADO_subdir)

# ART sources:
@ART_ENABLED@ART_subdir:= externals/art
@ART_ENABLED@all_files+= $(call find_files,$(srcdir),$(ART_subdir),'*.f90' '*.inc' '*.incf')
@ART_ENABLED@PVCS_bundled_srcdirs+= $(srcdir)/$(ART_subdir)

# MSGWAM sources:
@MSGWAM_ENABLED@MSGWAM_subdir:= externals/msgwam
@MSGWAM_ENABLED@all_files+= $(call find_files,$(srcdir),$(MSGWAM_subdir),'*.f90')
@MSGWAM_ENABLED@PVCS_bundled_srcdirs+= $(srcdir)/$(MSGWAM_subdir)

# ICON4PY binding sources:
@ICON4PY_ENABLED@ICON4PY_subdir:= externals/icon4py
@ICON4PY_ENABLED@ICON4PY_f90_file:= $(ICON4PY_subdir)/bindings_f90.f90
@ICON4PY_ENABLED@ICON4PY_c_file:= $(ICON4PY_subdir)/bindings_c.c
@ICON4PY_ENABLED@gen_files+= $(ICON4PY_f90_file) $(ICON4PY_c_file)

# Finalize the list of source files:
all_files+= $(gen_files)

# Fortran '.f90' source files:
f90_files:= $(filter %.f90,$(all_files))
# C '.c' source files:
c_files:= $(filter %.c,$(all_files))
# CUDA '.cu' source files:
@CUDA_ENABLED@cu_files:= $(filter %.cu,$(all_files))
# HIP '.hip.cc' source files:
@HIP_ENABLED@hip_files:= $(filter %.hip.cc,$(all_files))

# Paths to the directories with Fortran include files:
inc_dirs:= $(addprefix $(srcdir)/,$(patsubst %/,%,$(dir $(filter %.inc %.incf,$(all_files)))))
@DACE_ENABLED@inc_dirs+= $(patsubst %/,%,$(dir $(DACE_inc_files)))
# Eliminate duplicates:
inc_dirs:= $(sort $(inc_dirs))

# Extend Fortran compiler flags enabling the location of include files:
make_FCFLAGS+= $(foreach d,$(inc_dirs),@FC_INC_FLAG@$(d) @FC_INC_FLAG_PP_f90@$(d))

# Source files implementing test programs:
test_prog_f90_files:= $(call filter_notdir_patterns,test_%,$(filter $(test_subdir)/%,$(f90_files)))

# Source files implementing test programs that cannot be built in the current
# configuration:
test_skip_prog_f90_files:=
@MPI_ENABLED@test_skip_prog_f90_files+= $(call filter_notdir_substring,.nompi.,$(test_prog_f90_files))
@MPI_DISABLED@test_skip_prog_f90_files+= $(call filter_notdir_substring,.mpi.,$(test_prog_f90_files))

############################# PREPROCESSING CHAIN ##############################

# List of all preprocessed files:
pp_files:=

######## DSL4JSB PREPROCESSING #########
@JSBACH_ENABLED@DSL4JSB_in_f90_files:= $(JSBACH_dsl_files)
########################################
@JSBACH_ENABLED@DSL4JSB_infix:= $(pp_infix)jsb
@JSBACH_ENABLED@DSL4JSB_out_f90_files:= $(DSL4JSB_in_f90_files:.f90=$(DSL4JSB_infix).f90)
@JSBACH_ENABLED@f90_files:= $(filter-out $(DSL4JSB_in_f90_files),$(f90_files)) $(DSL4JSB_out_f90_files)
@JSBACH_ENABLED@pp_files+= $(DSL4JSB_out_f90_files)

#### EXPLICIT FORTRAN PREPROCESSING ####
@FPP_ENABLED@FPP_in_f90_files:= $(f90_files)
########################################
@FPP_ENABLED@FPP_infix:= $(pp_infix)fpp
@FPP_ENABLED@FPP_out_f90_files:= $(FPP_in_f90_files:.f90=$(FPP_infix).f90)
@FPP_ENABLED@f90_files:= $(filter-out $(FPP_in_f90_files),$(f90_files)) $(FPP_out_f90_files)
@FPP_ENABLED@pp_files+= $(FPP_out_f90_files)

####### SERIALBOX2 PREPROCESSING #######
@SB2_ENABLED@SB2_in_f90_files:= $(f90_files)
########################################
@SB2_ENABLED@SB2_infix:= $(pp_infix)sb2
@SB2_ENABLED@SB2_out_f90_files:= $(SB2_in_f90_files:.f90=$(SB2_infix).f90)
@SB2_ENABLED@f90_files:= $(filter-out $(SB2_in_f90_files),$(f90_files)) $(SB2_out_f90_files)
@SB2_ENABLED@pp_files+= $(SB2_out_f90_files)

# Dependency files
# (this finalizes the list of files eligible for compilation):
dep_files:= $(addsuffix .d,$(f90_files) $(c_files) $(cu_files) $(hip_files)) c_binding.d

############################ GENERATED EXECUTABLES #############################

# Auxiliary function. Receives a space-separated list of relative paths to the
# original Fortran '.f90' files and returns a space-separated list of paths to
# the respective object files (not necessarily in the respective order though),
# which change depending on the preprocessing steps applied to the original
# source files.
get_obj_names= $(patsubst %.f90,%.@OBJEXT@, \
                   $(filter $(foreach f,$(1),$(f) $(f:.f90=$(pp_infix)%.f90)),$(f90_files)))

# Auxiliary function. Receives a space-separated list of relative paths to the
# original Fortran '.f90' files implementing the test programs and returns a
# space-separated list of the respective test names.
get_test_names= $(patsubst $(test_subdir)/%.f90,%,$(1))

# Object files that must be injected into all executables:
common_prog_obj_files:=

# Main executable files:
exec_files:=

# ICON executable:
icon_exec_file:= $(bin_builddir)/icon@EXEEXT@
icon_prog_obj_files:= $(call get_obj_names,src/drivers/icon.f90) version.@OBJEXT@
exec_files+= $(icon_exec_file)

# Test executable files:
test_exec_files:= $(patsubst %.f90,%.x@EXEEXT@,$(filter-out $(test_skip_prog_f90_files),$(test_prog_f90_files)))
test_prog_obj_files:= $(call get_obj_names,$(test_exec_files:.x@EXEEXT@=.f90))

# List of tests to run by default in the current configuration:
TESTS:= $(call get_test_names,$(test_prog_f90_files))

############################## GENERATED ARCHIVES ##############################

# Generated archive (library) files:
lib_files:=

# Auxiliary function. Receives a space-separated list of paths to objects and
# returns a space-separated list of paths to their prerequisite objects. The
# input paths are excluded from the output.
get_prereq_objs= $(filter-out $(1),$(filter %.@OBJEXT@, \
                     $(shell $(DEPLIST) @deplist.config -t $(1) -f $(dep_files))))

# Common convenience library (holds prerequisite objects of the generated
# executables):
common_lib_file:= $(lib_builddir)/libicon.a
common_lib_prog_obj_files:= $(icon_prog_obj_files) $(common_prog_obj_files)
common_lib_obj_files:= $(call get_prereq_objs,$(common_lib_prog_obj_files))
lib_files+= $(common_lib_file)

# Convenience library for the tests (holds prerequisite objects of the test
# executables):
test_lib_file:= $(test_subdir)/libicontest.a
test_lib_prog_obj_files:= $(test_prog_obj_files) $(common_prog_obj_files)
test_lib_obj_files:= $(call get_prereq_objs,$(test_lib_prog_obj_files))
lib_files+= $(test_lib_file)

# Stamp files of the building subdirectories
# (this finalizes the list of generated files):
dir_files:= $(filter-out ./.dirstamp, \
                $(addsuffix .dirstamp, \
                    $(mod_builddir)/ \
                    $(sort \
                        $(dir $(gen_files) $(pp_files) $(dep_files) \
                            $(exec_files) $(test_exec_files) $(lib_files)))))

########################## PGI/NVIDIA INLINE LIBRARY ###########################

# Name of the inline library (a directory):
@PGI_INLIB_ENABLED@pgi_inlib_name:= $(lib_builddir)/icon.il

# List of procedures to be inlined:
@PGI_INLIB_ENABLED@pgi_inlib_procedures:=

# List of original Fortran '.f90' files containing $(pgi_inlib_procedures):
@PGI_INLIB_ENABLED@pgi_inlib_f90_files:=

# List of files to be compiled with the GPU register limit flag:
@PGI_INLIB_ENABLED@@GPU_ENABLED@pgi_inlib_reglim_f90_files:=

# Lengthy space-separated lists $(pgi_inlib_procedures), $(pgi_inlib_f90_files)
# and $(pgi_inlib_reglim_f90_files) are set in a separate file for the sake of
# readability:
@PGI_INLIB_ENABLED@include inlib.mk

# Auxiliary function. Turns a space-separated list into a comma-separated one.
join_comma_symbol:= ,
join_comma= $(subst $() ,$(join_comma_symbol),$(strip $(1)))

# Additional PGI/NVIDIA Fortran compiler flags enabling the inline library
# generation and usage:
@PGI_INLIB_ENABLED@pgi_inlib_common_arg:= lib:$(pgi_inlib_name),name:$(call join_comma,$(pgi_inlib_procedures))
@PGI_INLIB_ENABLED@pgi_inlib_ex_FCFLAGS:= -Mextract=$(pgi_inlib_common_arg)
@PGI_INLIB_ENABLED@@SEPARATE_MODS_ENABLED@dir_files+= $(mod_builddir_null)/icon.il/.dirstamp
@PGI_INLIB_ENABLED@@SEPARATE_MODS_ENABLED@pgi_inlib_ex_FCFLAGS+= @FC_MOD_OUT@$(mod_builddir_null)/icon.il
@PGI_INLIB_ENABLED@@SEPARATE_MODS_DISABLED@pgi_inlib_ex_FCFLAGS+= @FC_MOD_OUT@$(mod_builddir)
@PGI_INLIB_ENABLED@pgi_inlib_in_FCFLAGS:= -Minline=$(pgi_inlib_common_arg),reshape

# Additional flag limiting the GPU register usage (valid only if the inline
# library is enabled):
@PGI_INLIB_ENABLED@@GPU_ENABLED@pgi_inlib_reglim_FCFLAGS:= -gpu=maxregcount:96

########################################

# List of object files that correspond to the source files from
# $(pgi_inlib_f90_files) and are needed for the current configuration:
@PGI_INLIB_ENABLED@pgi_inlib_obj_files:= \
@PGI_INLIB_ENABLED@  $(filter $(common_lib_obj_files) $(common_lib_prog_obj_files), \
@PGI_INLIB_ENABLED@    $(call get_obj_names,$(pgi_inlib_f90_files)))

# List of the respective dependency files:
@PGI_INLIB_ENABLED@pgi_inlib_dep_files:= $(pgi_inlib_obj_files:.@OBJEXT@=.f90.d)

# List of Fortran module files declared (or extended via submodules) that
# correspond to $(pgi_inlib_obj_files):
@PGI_INLIB_ENABLED@pgi_inlib_mod_files:= \
@PGI_INLIB_ENABLED@  $(filter %.@FC_MOD_FILE_EXT@@FC_MOD_FILE_PROXYEXT@, \
@PGI_INLIB_ENABLED@    $(shell $(DEPLIST) -p $(pgi_inlib_obj_files) -f $(pgi_inlib_dep_files)))

# List of objects that are generated using the inline library:
@PGI_INLIB_ENABLED@pgi_inlib_target_obj_files:= \
@PGI_INLIB_ENABLED@  $(filter %.@OBJEXT@, \
@PGI_INLIB_ENABLED@    $(shell $(DEPLIST) -p $(pgi_inlib_obj_files) -f $(dep_files)))

# If a source file from $(pgi_inlib_f90_files) declares a submodule, the object
# file of the respective parent module should be generated using the inline
# library as well:
@PGI_INLIB_ENABLED@pgi_inlib_target_obj_files+= \
@PGI_INLIB_ENABLED@  $(patsubst %$(pp_infix)modstamp.f90,%.@OBJEXT@, \
@PGI_INLIB_ENABLED@    $(filter %.@OBJEXT@ %$(pp_infix)modstamp.f90, \
@PGI_INLIB_ENABLED@      $(shell $(DEPLIST) --no-hints --max-depth 1 -t $(pgi_inlib_mod_files) -f $(dep_files))))

# To avoid circular dependencies, we need to account for situations when we
# have a dependency A -> B -> C, where A and C belong to $(pgi_inlib_obj_files)
# but B does not. In order to get all such B files and include them into
# $(pgi_inlib_obj_files), we find the intersection of two sets: dependencies
# (prerequisites) and dependents (targets) of $(pgi_inlib_obj_files):
@PGI_INLIB_ENABLED@pgi_inlib_obj_files:= \
@PGI_INLIB_ENABLED@  $(filter $(pgi_inlib_target_obj_files), \
@PGI_INLIB_ENABLED@    $(shell $(DEPLIST) --no-hints -t $(pgi_inlib_obj_files) -f $(dep_files)))
@PGI_INLIB_ENABLED@pgi_inlib_dep_files:= $(pgi_inlib_obj_files:.@OBJEXT@=.f90.d)

# List of Fortran module and submodule files that must be created before the
# inline library:
@PGI_INLIB_ENABLED@pgi_inlib_prereq_mod_files:= \
@PGI_INLIB_ENABLED@  $(filter %.@FC_MOD_FILE_EXT@@FC_MOD_FILE_PROXYEXT@ %.@FC_SMOD_FILE_EXT@@FC_MOD_FILE_SPROXYEXT@, \
@PGI_INLIB_ENABLED@    $(filter-out \
@PGI_INLIB_ENABLED@      $(shell $(DEPLIST) --no-hints -p $(pgi_inlib_obj_files) -f $(pgi_inlib_dep_files)), \
@PGI_INLIB_ENABLED@      $(shell $(DEPLIST) --no-hints -t $(pgi_inlib_obj_files) $(pgi_inlib_obj_files:.@OBJEXT@=$(pp_infix)modstamp.f90) -f $(pgi_inlib_dep_files))))

############################### MAKEFILE TWEAKS ################################

# Issue warnings that command-line overrides of the installation prefixes are
# not supported:
$(foreach v,prefix exec_prefix bindir datarootdir datadir includedir libdir, \
  $(if $(filter $(origin $(v)),command line), \
    $(warning command-line override of the '$(v)' variable is not supported; \
        the provided value '$($(v))' will be ignored)))

# Silent rule prefixes:
V:= @DEFAULT_VERBOSITY@
ifeq ($(V),0)
silent_AR=      @echo "  AR      " $@;
silent_CC=      @echo "  CC      " $@;
silent_CMAKE=   @echo "  CMAKE   " $(@D);
silent_CONFIG=  @echo "  CONFIG  " $(@D);
silent_CUDACXX= @echo "  CUDACXX " $@;
silent_DEPGEN=  @echo "  DEPGEN  " $@;
silent_DSL4JSB= @echo "  DSL4JSB " $@;
silent_FC=      @echo "  FC      " $@;
silent_FCEX=    @echo "  FC (EX) " $(@D);
silent_FCIL=    @echo "  FC (IL) " $@;
silent_FCLD=    @echo "  FCLD    " $@;
silent_FPP=     @echo "  FPP     " $@;
silent_GEN=     @echo "  GEN     " $@;
silent_HIPCXX=  @echo "  HIPCXX  " $@;
silent_MKDIR=   @echo "  MKDIR   " $(@D);
silent_MOD=     @echo "  MOD    <" $<;
silent_SB2=     @echo "  SB2PP   " $@;
silent_none=    @
endif

# Sanitize the test colorization variable:
ifeq ($(ICON_COLOR_TESTS),always)
else ifeq ($(ICON_COLOR_TESTS),no)
else
override ICON_COLOR_TESTS:=
endif

# Test colorization and verbosity for the Automake-based packages:
AM_COLOR_TESTS?= $(ICON_COLOR_TESTS)
VERBOSE?= $(ICON_VERBOSE_TESTS)

# Test colorization and verbosity for the Autotest-based packages (also skip
# running the tests if requested):
TESTSUITEFLAGS?= \
  $(if $(ICON_COLOR_TESTS),--color=$(ICON_COLOR_TESTS)) \
  $(if $(ICON_VERBOSE_TESTS),--verbose) \
  $(if $(TESTS),,--keywords=_run_nothing_)

# Test colorization and verbosity for the CMake-based packages (also skip
# running the tests if requested):
CLICOLOR_FORCE?= $(if $(filter always,$(ICON_COLOR_TESTS)),1,0)
CLICOLOR?= $(if $(filter no,$(ICON_COLOR_TESTS)),0,1)
CTEST_OUTPUT_ON_FAILURE?= $(if $(ICON_VERBOSE_TESTS),1,0)
ARGS?= $(if $(TESTS),,--exclude-regex .)

# Test colorization for the GTest-based packages:
GTEST_COLOR?= \
  $(if $(filter always,$(ICON_COLOR_TESTS)),1, \
  $(if $(filter no,$(ICON_COLOR_TESTS)),0))

# Disable built-in suffix rules:
.SUFFIXES:
# Delete partially updated files:
.DELETE_ON_ERROR:
# Keep directory stamps:
.PRECIOUS: $(dir_files)
# Targets not associated with files:
.PHONY: all generate preprocess depend check install mostlyclean clean \
        distclean config-bundled bundled check-bundled check-icon dummy-depend \
        $(bundled_builddirs) force-create-version
@DEVELOPER_MODE_ENABLED@.PHONY: sanitize-mod-proxies

# Makefiles of the bundled packages:
bundled_makefiles:= $(addsuffix /Makefile,$(bundled_builddirs))

# Targets that do not need the dependency files:
nodep_targets:= generate preprocess depend mostlyclean clean distclean \
                config-bundled bundled check-bundled dummy-depend \
                $(bundled_builddirs) $(bundled_makefiles) version.c \
                version.@OBJEXT@ run/SETUP.config.install $(dep_files) \
                $(gen_files) $(pp_files) $(BUNDLED_LIBFILES)

# Selective search paths:
vpath %.f90 $(srcdir)
vpath %.c $(srcdir)
vpath %.cu $(srcdir)
vpath %.hip.cc $(srcdir)

################### PATTERN- AND TARGET-SPECIFIC ASSIGNMENTS ###################

# Pattern- and target-specific assignments can lead to unexpected side-effects.
# To have better control over them, all such assignments should be done in this
# section, once all global variables have their final values.

# Pattern- and target-specific assignments are propagated to the prerequisites
# and override the global assignments. Therefore, we introduce the following
# match-anything pattern assignments to prevent that:
@PGI_INLIB_ENABLED@%: make_FCFLAGS:= $(make_FCFLAGS)
%: ICON_FCFLAGS:= $(ICON_FCFLAGS)
#   The following variables have to be expanded recursively (i.e. they are
#   supposed to be lazily expanded when running the recipes). The eval/value
#   trick below prevents propagation of the target-specific values to the
#   prerequisites while keeping the recursive flavor of the variables:
@PGI_INLIB_ENABLED@$(eval %: silent_FC= $(value silent_FC))

# Target-specific variables enabling the PGI/NVIDIA inlining during compilation:
@PGI_INLIB_ENABLED@$(pgi_inlib_target_obj_files): silent_FC= $(silent_FCIL)
@PGI_INLIB_ENABLED@$(pgi_inlib_target_obj_files): make_FCFLAGS+= $(pgi_inlib_in_FCFLAGS)

# Compile $(pgi_inlib_reglim_f90_files) with the GPU register limit flag:
@PGI_INLIB_ENABLED@@GPU_ENABLED@$(call get_obj_names,$(pgi_inlib_reglim_f90_files)): make_FCFLAGS+= $(pgi_inlib_reglim_FCFLAGS)

# Pattern-specific Fortran compiler flags:
#   Note the difference in how older versions of GNU Make (at least up to 3.81)
#   treat pattern-specific variable ASSIGNMENTS and pattern RULES: the last
#   matching ASSIGNMENT and the first matching RULE win. Newer versions of GNU
#   Make (starting at least 4.1) give preference to the most specialized pattern
#   in both cases. This means that, as long as we support older version of GNU
#   Make, we have to declare the most general ASSIGNMENTS first and the most
#   general RULES last.
@FCGROUP_ASSIGNMENTS@

############################# USER INTERFACE RULES #############################

# Default rule:
all: $(exec_files)

# Explicit source file generation rule:
generate: version.c $(gen_files)

# Explicit preprocessing rule:
preprocess: $(pp_files)

# Explicit dependency generation rule:
depend: $(dep_files)

# Generate a list of files that are going to be compiled in the current
# configuration:
srclist: $(dep_files)
	$(silent_GEN)$(DEPLIST) -t $(common_lib_prog_obj_files) -f $^ 2>/dev/null | sed '/\.@OBJEXT@$$/d;/\.@FC_MOD_FILE_EXT@$(if @FC_MOD_FILE_PROXYEXT@,\@FC_MOD_FILE_PROXYEXT@)$$/d;/\.@FC_SMOD_FILE_EXT@$(if @FC_MOD_FILE_SPROXYEXT@,\@FC_MOD_FILE_SPROXYEXT@)$$/d' | sort > $@

# Check rule:
check: all check-bundled check-icon

# A general rule for clean recipes is to delete only those files that have been
# created explicitly, abandoning the idea of trying to delete all possible side
# effect files, e.g. Cray's *.i and *.lst files, MacOS's *.dSYM directories,
# Python's cache files, etc.

# Delete the results of compilation and linking:
mostlyclean: $(bundled_builddirs)
	rm -f $(exec_files) $(test_exec_files) $(lib_files)
	rm -f $(addsuffix .@OBJEXT@,$(basename $(f90_files) $(c_files) $(cu_files) $(hip_files))) version.@OBJEXT@
	rm -f $(mod_builddir)/*.@FC_MOD_FILE_EXT@ @DEVELOPER_MODE_ENABLED@ $(mod_builddir)/*.@FC_MOD_FILE_EXT@@FC_MOD_FILE_PROXYEXT@
	rm -f $(mod_builddir)/*.@FC_SMOD_FILE_EXT@ @DEVELOPER_MODE_ENABLED@ $(mod_builddir)/*.@FC_SMOD_FILE_EXT@@FC_MOD_FILE_SPROXYEXT@
	rm -f $(patsubst %,$(test_subdir)/%.log,$(TESTS)) $(test_subdir)/test-suite.log
@SEPARATE_MODS_ENABLED@	rm -rf $(mod_builddir_null) $(f90_files:.f90=$(pp_infix)modstamp.f90)
@PGI_INLIB_ENABLED@	rm -rf $(pgi_inlib_name)

# Delete files generated at the building stage (strictly speaking, we should
# also translate 'clean' into 'distclean' for the bundled packages when the
# delayed configuration is enabled but that would be counterproductive,
# therefore, we do not do that):
clean_files:= srclist version.c run/SETUP.config.install $(gen_files) $(pp_files)

# With all components and all preprocessing steps enabled, the list above
# contains ~3k filenames, which might result into the following error if we
# provide it on the command line as is:
#   make[1]: /bin/bash: Argument list too long
# To circumvent the issue, we have to split $(clean_files) into two lists.

# Auxiliary function. Receives a name of a variable containing a space-separated
# list. Splits the list into two ones that are twice as short (in terms of the
# number of elements). Each element of the input list can be found in one of the
# two output lists. In other words, if the input list L is a set, the result is
# two disjoint sets L1 and L2 such that |L1| - |L2| <= 1 and L = L1 U L2.
# Variables that contain the results have names <NAME>_1 and <NAME>_2, where
# <NAME> is the input name.
split_list= $(foreach e,$($(1)), \
                $(if $(filter $(words $($(1)_1)),$(words $($(1)_2))), \
                    $(eval $(1)_1+=$(e)),$(eval $(1)_2+=$(e))))

$(call split_list,clean_files)
clean: mostlyclean
	$(if $(clean_files_1),rm -f $(clean_files_1))
	$(if $(clean_files_2),rm -f $(clean_files_2))

# Delete everything generated at the configure stage (and clean the created
# directories if they are empty):
distclean: clean
	rm -f config.h config.log config.status depgen.c.config depgen.f90.config deplist.config collect.extra-libs
@PGI_INLIB_ENABLED@	rm -f inlib.mk
	rm -f run/collect.set-up.info run/set-up.info run/SETUP.config
@ICON4PY_ENABLED@	rm -rf $(ICON4PY_subdir)/.gt4py_cache $(ICON4PY_subdir)/run.env
	rm -f $(dep_files)
	rm -f $(dir_files)
	test -z "$(bundled_cmake_builddirs)" || rm -rf $(bundled_cmake_builddirs)
	@for dir in $(bin_builddir) $(lib_builddir) $(mod_builddir); do \
          if test -d "$$dir"; then \
            echo "find '$$dir' -type d -empty -delete"; \
            find "$$dir" -type d -empty -delete; \
          fi; \
	done
	@if test '.' != '$(srcdir)'; then \
	  for dir in $(subdirs) externals run test; do \
	    if test -d "$$dir"; then \
	      echo "find '$$dir' -type d -empty -delete"; \
	      find "$$dir" -type d -empty -delete; \
	    fi; \
	  done; \
	fi
	rm -f icon.mk

# Installation rule:
install: all run/SETUP.config.install
@COMIN_SHARED_ENABLED@	$(silent_none)echo 'Installation of the shared COMIN library is currently not supported.' >&2; exit 1
@COMIN_STATIC_ENABLED@	$(silent_none)$(MAKE) -C externals/comin/build $@ VERBOSE=$(filter-out 0,$(V))
@HD_ENABLED@	$(silent_none)$(MAKE) -C externals/hd $@ V=$(V) exec_prefix='@exec_prefix@' bindir='bin'
@MTIME_PYTHON_ENABLED@	$(silent_none)$(MAKE) -C externals/mtime/build/python $@ VERBOSE=$(filter-out 0,$(V))
@YAC_PYTHON_ENABLED@	$(silent_none)$(MAKE) -C externals/yac/python $@ V=$(V) prefix='@exec_prefix@'
	$(INSTALL) -d $(DESTDIR)@bindir@
	@for f in $(exec_files); do \
	  tf=`basename $$f | sed '$(TRANSFORM)'`; \
	  echo "$(INSTALL) '$$f' '$(DESTDIR)@bindir@/$$tf'"; \
	  $(INSTALL) "$$f" "$(DESTDIR)@bindir@/$$tf"; \
	done
	$(INSTALL) -d $(DESTDIR)@datadir@/run
	$(INSTALL) run/SETUP.config.install $(DESTDIR)@datadir@/run/SETUP.config

# Explicit configuration rule for the bundled packages:
config-bundled: $(bundled_makefiles)

# Explicit building rule for the bundled packages:
bundled: $(bundled_builddirs)

# Check rule for the bundled packages (run the tests serially to make the output
# readable and prevent from possible overloading due to multiple simultaneous
# MPI runs):
check-bundled: $(bundled_makefiles) $(bundled_cmake_builddirs) $(if $(filter check,$(MAKECMDGOALS)),all) # run the tests after 'all' when 'make check'
	@test -z '$(bundled_builddirs)' && echo "The list of bundled packages is empty: nothing to check." && exit 0; \
	fail=; \
	for d in $(bundled_builddirs); do \
	  case ' $(bundled_cmake_builddirs) ' in \
	    *" $$d "*) MAKEFLAGS='$(filter-out --jobserver-fds=% --jobserver-auth=%,$(MAKEFLAGS))' $(MAKE) -j1 -C "$$d" test VERBOSE=$(filter-out 0,$(V)) CLICOLOR_FORCE='$(CLICOLOR_FORCE)' CLICOLOR='$(CLICOLOR)' CTEST_OUTPUT_ON_FAILURE='$(CTEST_OUTPUT_ON_FAILURE)' GTEST_COLOR='$(GTEST_COLOR)' ARGS='$(ARGS)' || fail="$$fail$$d " ;; \
	    *) $(MAKE) -C "$$d" check V=$(V) AM_COLOR_TESTS='$(AM_COLOR_TESTS)' VERBOSE='$(VERBOSE)' TESTSUITEFLAGS='$(TESTSUITEFLAGS)' || fail="$$fail$$d " ;; \
	  esac; \
	done; \
	{ \
	  test x"$(ICON_COLOR_TESTS)" = xalways || { \
	    test x"$(ICON_COLOR_TESTS)" != xno && \
	      test x"$$TERM" != xdumb && \
	      { test -t 1; } 2>/dev/null; \
	  }; \
	} && { \
	  red='[0;31m'; std='[m'; \
	} || { \
	  red=; std=; \
	}; \
	if test -n "$$fail"; then echo "$${red}Tests failed in the following build directories of the bundled packages: $$fail$${std}" && false; fi # exit code of the last command must be zero if $fail is empty

# Run the test suite:
check-icon: $(test_exec_files) | $(if $(filter check,$(MAKECMDGOALS)),check-bundled)
	$(silent_none)$(PYTHON) $(srcdir)/utils/test_driver.py \
	--tests $(TESTS) \
	--skip-tests $(call get_test_names,$(test_skip_prog_f90_files)) \
	--src-dir='$(srcdir)' \
	--test-subdir='$(test_subdir)' \
	--test-exec-ext='.x@EXEEXT@' \
	--shell='$(SHELL)' \
	--mpi-launch='$(MPI_LAUNCH)' \
	--package-name-version='@PACKAGE_STRING@' $(if $(ICON_COLOR_TESTS),--colorize='$(ICON_COLOR_TESTS)') $(if $(ICON_VERBOSE_TESTS),--output-on-failure)

######################## COMPILATION AND LINKING RULES #########################

# Dependencies of the ICON executable:
$(icon_exec_file): $(icon_prog_obj_files) $(common_prog_obj_files) $(common_lib_file) $(BUNDLED_LIBFILES)

# Dependencies of the test executables:
$(foreach f,$(test_exec_files),$(eval $(f): $$(call get_obj_names,$(f:.x@EXEEXT@=.f90)) $$(common_prog_obj_files) $$(test_lib_file) $$(BUNDLED_LIBFILES)))

# Common linking rule for the executables:
#   List of files to be passed to the linker:
link_files= $+
#   Replace the relative path to libcomin.a (set in configure.ac), which is a
#   prerequisite of the linking rule and triggers the relinking when updated,
#   with the list of paths to the object files that are put into the library:
#     This is a portable (across different compilers) alternative to the
#     -Wl,--whole-archive/-Wl,--no-whole-archive flags. The list of object files
#     is generated by CMake when configuring COMIN via the wrapper
#     (utils/cmake-wrapper/CMakeLists.txt). The list references files by paths
#     that are relative to the build directory of COMIN, hence we prepend each
#     element of the list with it. The variable is evaluated inside the recipe
#     when COMIN is guaranteed to have been configured.
@COMIN_STATIC_ENABLED@link_files= $(subst externals/comin/build/_icon/libcomin.a,$(addprefix externals/comin/build/, \
@COMIN_STATIC_ENABLED@                $(shell cat ./externals/comin/build/CMakeFiles/icon-extra-libs.dir/link.txt)),$+)
$(exec_files) $(test_exec_files): | $(dir_files)
	$(silent_FCLD)$(FC) -o $@ $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) $(LDFLAGS) $(link_files) $(shell . ./collect.extra-libs) $(LIBS)

# Dependencies of the common convenience library:
$(common_lib_file): $(common_lib_obj_files)

# Dependencies of the test convenience library:
$(test_lib_file): $(test_lib_obj_files)

# Common archive generation rule:
$(lib_files): | $(dir_files)
	$(silent_AR)rm -f $@ && $(AR) $(ARFLAGS) $@ $^ && $(RANLIB) $@

# All objects that can be built with the inline library depend on it:
#   The compiler documentation suggests that we use $(pgi_inlib_name) as a
#   target and as a prerequisite but $(pgi_inlib_name) is a directory and using
#   directories as makefile targets is generally a bad idea. In particular, a
#   target directory is not removed on error, which means that if 'make' is
#   interrupted during the generation of the library, the subsequent 'make'
#   command will consider the library successfully created and erroneously
#   proceed with the next step. Therefore we use the table of contents of the
#   library, which is a regular file, as a target and as a dependency:
@PGI_INLIB_ENABLED@$(pgi_inlib_target_obj_files): $(pgi_inlib_name)/TOC

# PGI/NVIDIA inline library generation rule (note that the source files are
# provided to the compiler in the topological order):
@PGI_INLIB_ENABLED@$(pgi_inlib_name)/TOC: $(pgi_inlib_prereq_mod_files) $(pgi_inlib_obj_files:.@OBJEXT@=.f90) inlib.mk | $(dir_files)
@PGI_INLIB_ENABLED@	$(silent_FCEX)rm -rf $(@D) && $(FC) $(pgi_inlib_ex_FCFLAGS) $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) @FCFLAGS_f90@ $(filter %.f90,$^)

# Fortran compilation rule:
@SEPARATE_MODS_ENABLED@%.@OBJEXT@: %.f90 | $(dir_files) $(bundled_builddirs) @DEVELOPER_MODE_ENABLED@ sanitize-mod-proxies
@SEPARATE_MODS_ENABLED@	$(silent_FC)$(MKDIR_P) $(mod_builddir_null)/$* && $(FC) -o $@ -c @FC_MOD_OUT@$(mod_builddir_null)/$* $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) @FCFLAGS_f90@ $<

@SEPARATE_MODS_DISABLED@%.@OBJEXT@: %.f90 | $(dir_files) $(bundled_builddirs) @DEVELOPER_MODE_ENABLED@ sanitize-mod-proxies
@SEPARATE_MODS_DISABLED@	$(silent_FC)$(FC) -o $@ -c @FC_MOD_OUT@$(mod_builddir) $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) @FCFLAGS_f90@ $<

# Fortran module file generation rule:
@SEPARATE_MODS_ENABLED@%$(pp_infix)modstamp.f90: %.f90 | $(dir_files) $(bundled_builddirs) @DEVELOPER_MODE_ENABLED@ sanitize-mod-proxies
@SEPARATE_MODS_ENABLED@	$(silent_MOD)$(MKDIR_P) $(mod_builddir_null)/$* && $(FC) -o $(mod_builddir_null)/$*/dummy.@OBJEXT@ -c @FC_MOD_OUT@$(mod_builddir) $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) @FC_MOD_ONLY@ @FCFLAGS_f90@ $< && touch $@

# Fortran module file tracking and recovery rule:
@DEVELOPER_MODE_ENABLED@$(mod_builddir)/%.@FC_MOD_FILE_EXT@@FC_MOD_FILE_PROXYEXT@:| sanitize-mod-proxies
@DEVELOPER_MODE_ENABLED@	@if test -n '$<'; then \
@DEVELOPER_MODE_ENABLED@	  if test ! -f '$(@:@FC_MOD_FILE_PROXYEXT@=)'; then rm -f '$<'; $(MAKE) -f icon.mk '$<'; fi; \
@DEVELOPER_MODE_ENABLED@	  if cmp '$@' '$(@:@FC_MOD_FILE_PROXYEXT@=)' >/dev/null 2>&1 || $(MODCMP) '$@' '$(@:@FC_MOD_FILE_PROXYEXT@=)' @FC_VENDOR@ 2>/dev/null; then :; \
@DEVELOPER_MODE_ENABLED@	  else cp '$(@:@FC_MOD_FILE_PROXYEXT@=)' '$@' 2>/dev/null; fi; \
@DEVELOPER_MODE_ENABLED@	fi

# Fortran submodule file tracking and recovery rule:
@DEVELOPER_MODE_ENABLED@$(mod_builddir)/%.@FC_SMOD_FILE_EXT@@FC_MOD_FILE_SPROXYEXT@:| sanitize-mod-proxies
@DEVELOPER_MODE_ENABLED@	@if test -z '$<'; then \
@DEVELOPER_MODE_ENABLED@	  echo "Cannot find Fortran source file providing submodule '$(basename $(@F:@FC_MOD_FILE_SPROXYEXT@=))'." >&2; \
@DEVELOPER_MODE_ENABLED@	else \
@DEVELOPER_MODE_ENABLED@	  if test ! -f '$(@:@FC_MOD_FILE_SPROXYEXT@=)'; then rm -f '$<'; $(MAKE) '$<'; fi; \
@DEVELOPER_MODE_ENABLED@	  if cmp '$@' '$(@:@FC_MOD_FILE_SPROXYEXT@=)' >/dev/null 2>&1 || $(MODCMP) '$@' '$(@:@FC_MOD_FILE_SPROXYEXT@=)' @FC_VENDOR@ 2>/dev/null; then :; \
@DEVELOPER_MODE_ENABLED@	  else cp '$(@:@FC_MOD_FILE_SPROXYEXT@=)' '$@' 2>/dev/null; fi; \
@DEVELOPER_MODE_ENABLED@	fi

# Delete all Fortran (sub)module proxy files that do not have an existing
# (sub)module to be a proxy of, i.e. if <filename>@FC_MOD_FILE_PROXYEXT@ exists
# but <filename> does not, delete <filename>@FC_MOD_FILE_PROXYEXT@:
@DEVELOPER_MODE_ENABLED@sanitize-mod-proxies:
@DEVELOPER_MODE_ENABLED@	@rm -f $(filter-out $(addsuffix @FC_MOD_FILE_PROXYEXT@,$(wildcard $(mod_builddir)/*.@FC_MOD_FILE_EXT@)),$(wildcard $(mod_builddir)/*.@FC_MOD_FILE_EXT@@FC_MOD_FILE_PROXYEXT@)) $(filter-out $(addsuffix @FC_MOD_FILE_SPROXYEXT@,$(wildcard $(mod_builddir)/*.@FC_SMOD_FILE_EXT@)),$(wildcard $(mod_builddir)/*.@FC_SMOD_FILE_EXT@@FC_MOD_FILE_SPROXYEXT@))

# C compilation rule:
%.@OBJEXT@: %.c | $(dir_files)
	$(silent_CC)$(CC) -o $@ -c $(CFLAGS) $(CPPFLAGS) $<

# CUDA compilation rule:
@CUDA_ENABLED@%.@OBJEXT@: %.cu | $(dir_files)
@CUDA_ENABLED@	$(silent_CUDACXX)$(CUDACXX) -o $@ -c $(CUDAFLAGS) $<

# HIP compilation rule:
@HIP_ENABLED@%.@OBJEXT@: %.hip.cc | $(dir_files)
@HIP_ENABLED@	$(silent_HIPCXX)$(HIPCXX) -o $@ -c $(HIPFLAGS) $<

################ SOURCE FILE GENERATION AND PREPROCESSING RULES ################

# Directory generation rule:
%/.dirstamp:
	$(silent_MKDIR)$(MKDIR_P) $(@D) && touch $@

# Version file generation rules:
version.@OBJEXT@: config.h
version.c: force-create-version
	$(silent_GEN)$(PVCS) --srcdir $(srcdir) --output $@ --bundled-srcdirs $(PVCS_bundled_srcdirs)

# ICON4PY Fortran binding generation rule:
@ICON4PY_ENABLED@$(ICON4PY_f90_file):| $(dir_files)
@ICON4PY_ENABLED@	$(silent_GEN)GT4PY_BUILD_CACHE_DIR=$(@D) $(PYTHON) -m icon4py.bindings.all_bindings --output-f90 $@

# ICON4PY C binding generation rule:
@ICON4PY_ENABLED@$(ICON4PY_c_file):| $(dir_files)
@ICON4PY_ENABLED@	$(silent_GEN)GT4PY_BUILD_CACHE_DIR=$(@D) $(PYTHON) -m icon4py.bindings.all_bindings --output-c $@

# DSL4JSB preprocessing rule:
@JSBACH_ENABLED@%$(DSL4JSB_infix).f90: %.f90 | $(dir_files)
@JSBACH_ENABLED@	$(silent_DSL4JSB)$(DSL4JSB) -i $< -o $@

# Explicit Fortran preprocessing rule:
@FPP_ENABLED@%$(FPP_infix).f90: %.f90 | $(dir_files)
@FPP_ENABLED@	$(silent_FPP)$(FPP) $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS) $< >$@

# Serialbox2 preprocessing rule:
@SB2_ENABLED@%$(SB2_infix).f90: %.f90  | $(dir_files)
@SB2_ENABLED@	$(silent_SB2)$(SB2PP) -o $@ $<

############################ BUNDLED PACKAGE RULES #############################

# We need to tolerate the absence of makefiles in the bundled packages when
# running clean rules. If the delayed configuration is disabled, we tolerate the
# absence of the makefiles for the 'distclean' target only. Otherwise, we
# additionally enable the tolerance for the 'mostlyclean' and 'clean' targets
# because they can be requested before the bundled packages are configured:
nomakefile_bundled_targets:= distclean
@DELAYED_CONFIG_ENABLED@nomakefile_bundled_targets+= mostlyclean clean

# Make Autoconf-based bundled packages:
$(bundled_config_builddirs):
	@if test -f '$@/Makefile'; then \
	  $(MAKE) -C $@ $(filter all mostlyclean clean distclean,$(MAKECMDGOALS)) V=$(V) bindir='bin'; \
	else \
	  test -z '$(filter-out $(nomakefile_bundled_targets),$(or $(MAKECMDGOALS),all))'; \
	fi

# Make CMake-based bundled packages:
$(bundled_cmake_builddirs):
	@if test -f '$@/Makefile'; then \
	  $(MAKE) -C $@ $(filter all clean,$(MAKECMDGOALS) $(if $(filter mostlyclean distclean,$(MAKECMDGOALS)),clean)) VERBOSE=$(filter-out 0,$(V)); \
	else \
	  test -z '$(filter-out $(nomakefile_bundled_targets),$(or $(MAKECMDGOALS),all))'; \
	fi

# The configuration and build order of the bundled packages:
@BUNDLED_RULES@

############################### AUXILIARY RULES ################################

# Installable version of SETUP.config
run/SETUP.config.install: run/SETUP.config
	$(silent_GEN):;{ \
	  sed '/^abs_top_srcdir = /d' $< ; \
	  echo ; \
	  echo '# Install settings' ; \
	  echo PREFIX = $(DESTDIR)@prefix@ ; \
	  echo BIN_DIR = $(DESTDIR)@bindir@ ; \
	} > $@

# Directory creation rule:
%/.dirstamp:
	$(silent_MKDIR)$(MKDIR_P) $(@D) && touch $@

# Keep directory stamps:
.PRECIOUS: $(dir_files)

######################### DEPENDENCY GENERATION RULES ##########################

# Fortran dependency generation rule:
%.f90.d: %.f90 icon.mk depgen.f90.config | $(dir_files)
	$(silent_DEPGEN)$(DEPGEN) @depgen.f90.config -o $@ --obj-name $(@:.f90.d=.@OBJEXT@) $(if @SEPARATE_MODS_DISABLED@,--fc-mod-stamp-name $(@:.f90.d=$(pp_infix)modstamp.f90)) -i $< -- $(DEPGEN_FCFLAGS) @FC_MOD_OUT@$(mod_builddir) $(make_FCFLAGS) $(FCFLAGS) $(ICON_FCFLAGS)

# C dependency generation rule:
%.c.d: %.c icon.mk depgen.c.config | $(dir_files)
	$(silent_DEPGEN)$(DEPGEN) @depgen.c.config -o $@ --obj-name $(@:.c.d=.@OBJEXT@) -i $< -- $(CFLAGS) $(CPPFLAGS)

# CUDA dependency generation rule:
@CUDA_ENABLED@%.cu.d: %.cu icon.mk depgen.c.config | $(dir_files)
@CUDA_ENABLED@	$(silent_DEPGEN)$(DEPGEN) @depgen.c.config --pp-inc-sys -o $@ --obj-name $(@:.cu.d=.@OBJEXT@) -i $< -- $(CUDAFLAGS)

# HIP dependency generation rule:
@HIP_ENABLED@%.hip.cc.d: %.hip.cc icon.mk depgen.c.config | $(dir_files)
@HIP_ENABLED@	$(silent_DEPGEN)$(DEPGEN) @depgen.c.config --pp-inc-sys -o $@ --obj-name $(@:.hip.cc.d=.@OBJEXT@) -i $< -- $(HIPFLAGS)

# Dependency generation rule for Fortran-to-C bindings:
c_binding.d: icon.mk
	$(silent_DEPGEN):;{ \
	  echo '$(call get_obj_names,src/shared/mo_util_vcs.f90): #-hint version.@OBJEXT@'; \
	  echo '$(call get_obj_names,src/io/restart/mo_c_restart_util.f90): #-hint support/util_multifile_restart.@OBJEXT@'; \
	  echo '$(call get_obj_names,support/mo_util_uuid.f90): #-hint support/util_uuid.@OBJEXT@'; \
	  echo '@GPU_ENABLED@$(call get_obj_names,src/shared/mo_index_list.f90): #-hint support/index_list.@OBJEXT@'; \
	  echo '@DACE_ENABLED@$(call get_obj_names,$(DACE_subdir)/mo_wigos.f90): #-hint $(DACE_subdir)/dace_md5_ifc.@OBJEXT@ $(DACE_subdir)/md5.@OBJEXT@'; \
	  echo '@ICON4PY_ENABLED@$(call get_obj_names,$(ICON4PY_f90_file)): #-hint $(ICON4PY_c_file:.c=.@OBJEXT@)'; \
	} >$@

# Dummy dependency file generation rule (called by config.status):
dummy-depend: | $(dir_files)
	@for file in $(dep_files); do \
	  test -e "$$file" || touch "$$file"; \
	done

# Include dependencies if required:
ifneq (,$(filter-out $(nodep_targets),$(or $(MAKECMDGOALS),all)))
include $(dep_files)
endif
