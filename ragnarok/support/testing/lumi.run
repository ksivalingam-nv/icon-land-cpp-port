set -eu
unset CDPATH
ulimit -c 0

set -x

script_dir=$(cd "$(dirname "$0")"; pwd)
base_dir=$(cd "${script_dir}/../.."; pwd)
build_dir="${base_dir}/build"

# Always perform a fresh build
rm -rf ${build_dir}

# Always log the slurm env
env | grep 'SLURM_' || true

case ${LUMI_TARGET-} in
  gpu)
    module load CrayEnv PrgEnv-cray cce/20.0.0 craype-x86-trento craype-accel-amd-gfx90a rocm/6.2.4 cray-mpich cray-hdf5 cray-netcdf cray-libsci cray-python
    cmake -S ${base_dir} -B ${build_dir} -G 'Unix Makefiles' -C ${base_dir}/cmake/caches/lumi_gpu_cray.cmake
    ;;
  cpu)
    module load PrgEnv-cray cce/20.0.0 craype-x86-milan cray-mpich cray-hdf5 cray-netcdf cray-libsci cray-python
    cmake -S ${base_dir} -B ${build_dir} -G 'Unix Makefiles' -C ${base_dir}/cmake/caches/lumi_cpu_cray.cmake
    ;;
  *)
    echo "don't know what to build!"
    exit 1
    ;;
esac
cmake --build ${build_dir}

cd ${build_dir}

# support three different execution modes:
# 1. srun:
#   get an allocation with
#     srun -A project_465002727 -p standard-g -N 1 --gpus-per-node=1 -t 01:00:00 --pty bash -i
#   in there the GPU access is granted already
#
# 2. sbatch:
#   submit a script that already has GPU access on execution time (like buildbot)
#     #SBATCH --nodes=1
#     #SBATCH --ntasks-per-node=8
#     #SBATCH --gpus-per-node=8
#     #SBATCH --mem=0
#     #SBATCH --time=00:10:00
#     #SBATCH --partition=dev-g
#
# 3  salloc:
#   an allocation, that does NOT have immediate access to the GPU resource
#     salloc  -A project_465000454 -N1  -n 8 --time=00:20:00 -pdev-g  --gpus-per-node=8
#
# 1 + 2 can run `ctest`. Using 3 an addition `srun` is needed infront of `ctest`

if [ -z "${SLURM_STEP_ID:-}" ]; then
    # No active step — need srun to get GPU access (e.g. salloc case)
    srun -n1 ragnarok_test
else
    # Already in a step or sbatch batch context with GPU access
    ./ragnarok_test
fi
