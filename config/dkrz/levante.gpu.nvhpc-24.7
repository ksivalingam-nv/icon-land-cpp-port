set -eu
unset CDPATH
ulimit -c 0

script_dir=$(cd "$(dirname "$0")"; pwd)
icon_dir=$(cd "${script_dir}/../.."; pwd)

NVHPC_ROOT='/sw/spack-levante/nvhpc-24.7-py26uc/Linux_x86_64/24.7'
GCC_ROOT='/sw/spack-levante/gcc-11.2.0-bcn7mb'

STDCPP_ROOT=${GCC_ROOT}
STDCPP_LIBS='-lstdc++'

CUDA_ROOT="${NVHPC_ROOT}/cuda/12.5"
CUDA_LIBS='-lcudart -lcuda'

MPI_ROOT="${NVHPC_ROOT}/comm_libs/12.5/openmpi4/openmpi-4.1.5"

HDF5_ROOT='/sw/spack-levante/hdf5-1.14.3-oklh2t'
HDF5_LIBS='-lhdf5_hl -lhdf5'

NETCDF_ROOT='/sw/spack-levante/netcdf-c-main-rpye7o'
NETCDF_LIBS='-lnetcdf'

NETCDFF_ROOT='/sw/spack-levante/netcdf-fortran-4.6.1-y65bmi'
NETCDFF_LIBS='-lnetcdff'

BLAS_LAPACK_LIBS='-llapack -lblas'

ECCODES_ROOT='/sw/spack-levante/eccodes-2.25.0-5tftlm'
ECCODES_LIBS='-leccodes'

FYAML_ROOT='/sw/spack-levante/libfyaml-0.7.12-fvbhgo'
FYAML_LIBS='-lfyaml'

XML2_ROOT='/usr'
XML2_LIBS='-lxml2'

################################################################################

BUILD_ENV="export LD_LIBRARY_PATH=\"${STDCPP_ROOT}/lib64:${HDF5_ROOT}/lib:${NETCDF_ROOT}/lib64:${NETCDFF_ROOT}/lib:${ECCODES_ROOT}/lib64:${FYAML_ROOT}/lib:\${LD_LIBRARY_PATH}\"; export LIBRARY_PATH=\"${CUDA_ROOT}/lib64/stubs:\${LIBRARY_PATH}\"; export CUDAToolkit_ROOT='${CUDA_ROOT}'; export MPI_ROOT=\"${MPI_ROOT}\";"

CC="${MPI_ROOT}/bin/mpicc"
CFLAGS='-g -O2'

# Let CDI know it can enable the support for compression filters even with the
# older NetCDF version:
ICON_CDI_CFLAGS='-DHAVE_DECL_NCAUX_H5FILTERSPEC_PARSELIST'
# Let YAC find LAPACK with the C compiler:
ICON_YAC_CFLAGS='-fortranlibs'

CXX="${NVHPC_ROOT}/compilers/bin/nvc++"
CXXFLAGS='-g -O2'

CPPFLAGS="-I${HDF5_ROOT}/include -I${NETCDF_ROOT}/include -I${ECCODES_ROOT}/include -I${FYAML_ROOT}/include -I${XML2_ROOT}/include/libxml2"

FC="${MPI_ROOT}/bin/mpifort"
FCFLAGS="-I${NETCDFF_ROOT}/include -g -O2 -Mrecursive -Mallocatable=03 -Mstack_arrays -Minfo=accel,inline -acc=gpu,verystrict -gpu=cc80,cuda12.5"

CUDACXX="${CUDA_ROOT}/bin/nvcc"
CUDAFLAGS="-ccbin=${CXX} -arch=sm_80 -g -O3"

LDFLAGS="-L${STDCPP_ROOT}/lib64 -L${CUDA_ROOT}/lib64 -L${HDF5_ROOT}/lib -L${NETCDF_ROOT}/lib64 -L${NETCDFF_ROOT}/lib -L${ECCODES_ROOT}/lib64 -L${FYAML_ROOT}/lib"

LIBS="-Wl,--as-needed ${XML2_LIBS} ${FYAML_LIBS} ${ECCODES_LIBS} ${BLAS_LAPACK_LIBS} ${NETCDFF_LIBS} ${NETCDF_LIBS} ${HDF5_LIBS} ${CUDA_LIBS} ${STDCPP_LIBS}"

MPI_LAUNCH="${MPI_ROOT}/bin/mpiexec"

EXTRA_CONFIG_ARGS='--enable-gpu --enable-mpi-gpu --enable-bundled-python=mtime --enable-cuda-graphs --enable-dim-swap'

PYTHON='/work/mh1570/m215048/ci/venv/bin/python3'
################################################################################

"${icon_dir}/configure" \
BUILD_ENV="${BUILD_ENV}" \
CC="${CC}" \
CFLAGS="${CFLAGS}" \
CPPFLAGS="${CPPFLAGS}" \
CUDACXX="${CUDACXX}" \
CUDAFLAGS="${CUDAFLAGS}" \
CXX="${CXX}" \
CXXFLAGS="${CXXFLAGS}" \
FC="${FC}" \
FCFLAGS="${FCFLAGS}" \
ICON_CDI_CFLAGS="${ICON_CDI_CFLAGS}" \
ICON_YAC_CFLAGS="${ICON_YAC_CFLAGS}" \
LDFLAGS="${LDFLAGS}" \
LIBS="${LIBS}" \
MPI_LAUNCH="${MPI_LAUNCH}" \
${EXTRA_CONFIG_ARGS} \
PYTHON="${PYTHON}" \
"$@"

for arg in "$@"; do
  case $arg in
    -help | --help | --hel | --he | -h | -help=r* | --help=r* | --hel=r* | --he=r* | -hr* | -help=s* | --help=s* | --hel=s* | --he=s* | -hs*)
      test -n "${EXTRA_CONFIG_ARGS}" && echo '' && echo "This wrapper script ('$0') calls the configure script with the following extra arguments, which might override the default values listed above: ${EXTRA_CONFIG_ARGS}"
      exit 0 ;;
  esac
done

# Copy runscript-related files when building out-of-source:
if test '0' = "${ICON_NO_OOS_RUNSCRIPT_COPY-0}" && test $(pwd) != $(cd "${icon_dir}"; pwd); then
  echo "Copying runscript input files from the source directory..."
  rsync -uavz ${icon_dir}/run . --exclude='*.in' --exclude='.*' --exclude=mkexp
  ln -sf -t run/ ${icon_dir}/run/mkexp
fi
