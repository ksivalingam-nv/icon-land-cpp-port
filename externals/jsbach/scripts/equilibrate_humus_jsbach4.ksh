#----------------------------------------------------------------------------------------------
#
# Script to set the amount of carbon in the YASSO humus pools closer to equilibrium.
#
# Depending on the simulation set-up the script uses different aggregation levels of the in- and output
# to the humus pool: for a simulation without natural land cover changes the values per pft are used,
# for a simulation with natural land cover changes the box value is used.
#
# It is possible to update humus pools using multi-file restart files. The resulting restart file
# - including the new humus pools - will however be a single file. To be able to continue the
# simulation you should use the script "cpool_file_from_restart_file.sh" in the same directory.
# The resulting cpools file can be read by ICON-Land if "read_cpools = .true." in namelist
# "jsb_carbon_nml". (Make sure to set the switch to false again in the following year!)
# Changing from multi- to single-restart files to continue the simulation currently does not work
# because some meta data is missing in the restart file generated by this script.
#
# Note:
# - The script uses tile average (ta) variables, not per canopy variables to avoid numerical issues
#   in simulations with natural land cover change (NLCC).
#  (+ in addition an average over the pfts is used when applying natural LCC -- using an aggregated
#     variable from an upper layer of the tile hierarchy might catch potential numeric instabilities
#     potentially caused by fractional changes and resulting implicit scaling)
# - works on the pft level - not yet below!
# - The other carbon pools need to be close to equilibrium before ${year_start}.
# - This script needs 4 digit year dates.
#
#
# julia.nabel@mpimet.mpg.de 2020
# Based on the script "equilibriate_humus.ksh" developed by Thomas Raddatz for jsbach3 (Dec 2018)
#----------------------------------------------------------------------------------------------

# Parameters that need to be adapted

exp=picontrol                        # experiment ID
restartPrefix=${exp}_restart_atm_    # Restart file name is generated from prefix and suffix such:
restartSuffix=0101T000000Z           #   ${restartPrefix}<YEAR>${restartSuffix}.nc
path_restart=/work/bb1469/b383102/restart_files/${exp}  # path to original restart files

work=/scratch/m/m220053/equilibrateC/${exp}    # temporary directory for working (will be removed!)
path_restart_out=/work/mh1496/m220053/equilibrateC/${exp}  # directory for the new restart file
                                                           # with equilibrated humus pools
year_start=2896      # first year of period to determine average fluxes
year_end=2920        # last year of that period
nyear_restart=1      # number of years within one restart cycle
with_NLCC=false
pfts=( 01 02 03 04 05 06 07 08 09 10 11 12 )

clean_up=true        # remove ${work} if script ran successfully

#-- End of specification part-------------------------------------------------------------------

cdo="cdo -s"
rm=/bin/rm
cp=/bin/cp
mv=/bin/mv
expr=/usr/bin/expr

set -e

[[ -d ${work} ]] || mkdir -p ${work}

# Final restart file: will be modified (not overwritten)
restartToModify=${restartPrefix}${year_end}${restartSuffix}.nc

if [[ -d ${path_restart}/${restartToModify} ]]; then
  multi_file_restart=true
else
  multi_file_restart=false
fi

# Generate single-file restart files from multi-file restart files
if [[ ${multi_file_restart} == true ]] then
  echo ""
  echo " Convert multi-file restart files to single-file restart files"
  year=${year_start}
  while [[ ${year} -le ${year_end} ]]; do
    restart_file=${restartPrefix}${year}${restartSuffix}.nc
    echo "   Processing ${restart_file} ..."
    if [[ ! -f ${work}/${restart_file} ]]; then
      ${cdo} collgrid ${path_restart}/${restart_file}/patch*.nc ${work}/${restart_file}
    fi
    (( year = year + nyear_restart ))
  done
fi

# Copy the last restart file, which will be adapted
if [[ ${multi_file_restart} == true ]] then
  path_restart=${work}
  ${cp} ${work}/${restartToModify}         ${work}/tmp_restart.nc
else
  ${cp} ${path_restart}/${restartToModify} ${work}/tmp_restart.nc
fi

echo ""
echo " Diagnose equilibrium humus pools"
# loop over pfts
for ipft in ${pfts[@]}; do
  echo "   pft${ipft} ..."

  if [[ ${with_NLCC} == true ]]; then
    # if with natural LCC: collect the information only once and for the veg tile
    fortile=veg
    if [[ ${ipft} == ${pfts[0]} ]]; then
      calcFactors=true
    else
      calcFactors=false
    fi
  else
    # collect it for the specific pft
    fortile=pft${ipft}
    calcFactors=true
  fi

  # Generate a list of all restart files in the given time period to determine the
  # average fluxes to and from the humus pools and the average decomposition rates.
  if [[ ${calcFactors} == true ]]; then
    # List of restart files
    restart_files=""
    year=${year_start}
    while [ ${year} -le ${year_end} ] ; do
      restart_files="${restart_files} ${path_restart}/${restartPrefix}${year}${restartSuffix}.nc"
      (( year = year + 1 ))
    done

    # Extract fluxes to and from the humus pools from the list of restart files
    humus_fluxes="carbon_c_decomp_humus_1_sum_ta_${fortile},carbon_c_decomp_humus_2_sum_ta_${fortile},carbon_c_into_humus_1_sum_ta_${fortile},carbon_c_into_humus_2_sum_ta_${fortile}"
    ${cdo} -timmean -mergetime -apply,-selname,${humus_fluxes} [ ${restart_files} ] \
           ${work}/humus_pools_${year_start}-${year_end}.nc

    # Calculate factors to equilibrate humus pools
    ${cdo} -expr,"factor_humus1=carbon_c_into_humus_1_sum_ta_${fortile}/carbon_c_decomp_humus_1_sum_ta_${fortile}" \
           ${work}/humus_pools_${year_start}-${year_end}.nc   ${work}/factor_humus_1.nc
    ${cdo} -expr,"factor_humus2=carbon_c_into_humus_2_sum_ta_${fortile}/carbon_c_decomp_humus_2_sum_ta_${fortile}" \
           ${work}/humus_pools_${year_start}-${year_end}.nc   ${work}/factor_humus_2.nc
  fi

  # Calculate equilibrium humus pools for the current pft
  ${cdo} -mul -selvar,carbon_c_humus_1_pft${ipft} ${path_restart}/${restartToModify} ${work}/factor_humus_1.nc \
          ${work}/c_H1_eq_pft${ipft}.nc
  ${cdo} -mul -selvar,carbon_c_humus_2_pft${ipft} ${path_restart}/${restartToModify} ${work}/factor_humus_2.nc \
          ${work}/c_H2_eq_pft${ipft}.nc

  if [[ ${with_NLCC} == false ]]; then
    ${rm} ${work}/factor_humus_?.nc
  fi
done

# Replace newly calculated humus pools in the restart file
echo ""
echo " Adapt final restart file"
$rm -f ${work}/humus_pools.nc
${cdo} merge ${work}/c_H1_eq_pft*.nc ${work}/c_H2_eq_pft*.nc ${work}/humus_pools.nc
${cdo} replace ${path_restart}/${restartToModify} ${work}/humus_pools.nc \
       ${path_restart_out}/${restartToModify%.nc}_eqC.nc

# Clean up
[[ ${clean_up} == true ]] && ${rm} -rf ${work}

echo "  Restart file with equilibrated humus pools:"
echo "     ${path_restart_out}/${restartToModify%.nc}_eqC.nc"
echo " - done -"
exit 0
